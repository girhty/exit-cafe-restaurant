---
---

<section id="about" class="relative py-24 lg:py-32 bg-white overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-latte to-transparent"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      <!-- Left: Image Composition -->
      <div class="relative">
        <div class="relative">
          <!-- Main image placeholder -->
          <div class="aspect-[4/5] bg-gradient-to-br from-latte via-caramel/30 to-mocha/20 rounded-3xl overflow-hidden shadow-2xl shadow-espresso/10 relative">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center space-y-4 p-8">
                <div class="w-20 h-20 bg-espresso/10 rounded-full flex items-center justify-center mx-auto">
                  <svg class="w-10 h-10 text-mocha" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                </div>
                <p class="text-mocha/60 font-display text-lg italic">Our story, our passion</p>
              </div>
            </div>
          </div>

          <!-- Floating badge -->
          <div class="absolute -bottom-6 -right-6 lg:-right-10 bg-espresso text-cream rounded-2xl p-5 shadow-2xl">
            <div class="text-center">
              <span class="block font-display text-3xl font-bold text-gold">126+</span>
              <span class="text-cream/70 text-xs uppercase tracking-wider">Happy Guests</span>
            </div>
          </div>

          <!-- Decorative element -->
          <div class="absolute -top-6 -left-6 w-24 h-24 border-2 border-caramel/30 rounded-2xl"></div>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="space-y-8">
        <div>
          <span class="text-terracotta font-semibold text-sm uppercase tracking-widest">Our Story</span>
          <h2 class="font-display text-4xl sm:text-5xl font-bold text-espresso mt-4 leading-tight">
            A Taste of
            <span class="text-terracotta">Basrah's Heart</span>
          </h2>
        </div>

        <div class="space-y-5 text-espresso/70 text-lg leading-relaxed">
          <p>
            Born from a deep love for Basrah's vibrant culture and rich culinary heritage, Exit Café & Restaurant is more than a dining destination — it's a <strong class="text-espresso">sanctuary for the senses</strong>.
          </p>
          <p>
            Every dish tells a story of tradition reimagined, blending time-honored Iraqi recipes with contemporary flair. Our coffee is sourced from the finest beans, roasted to perfection, and crafted by skilled baristas who pour their heart into every cup.
          </p>
          <p>
            Whether you're seeking a quiet corner for contemplation, a lively gathering with friends, or an intimate dinner that lingers in memory — <strong class="text-espresso">Exit is your escape</strong>.
          </p>
        </div>

        <!-- Features -->
        <div class="grid grid-cols-2 gap-6 pt-4">
          <div class="space-y-2">
            <div class="w-10 h-10 bg-terracotta/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h4 class="font-semibold text-espresso">Fresh Ingredients</h4>
            <p class="text-espresso/60 text-sm">Locally sourced, always fresh</p>
          </div>
          <div class="space-y-2">
            <div class="w-10 h-10 bg-terracotta/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h4 class="font-semibold text-espresso">Expert Baristas</h4>
            <p class="text-espresso/60 text-sm">Crafted with passion & skill</p>
          </div>
          <div class="space-y-2">
            <div class="w-10 h-10 bg-terracotta/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h4 class="font-semibold text-espresso">Cozy Space</h4>
            <p class="text-espresso/60 text-sm">Designed for comfort</p>
          </div>
          <div class="space-y-2">
            <div class="w-10 h-10 bg-terracotta/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-terracotta" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h4 class="font-semibold text-espresso">Fast Service</h4>
            <p class="text-espresso/60 text-sm">Quick & attentive always</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>