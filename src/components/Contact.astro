---
---

<section id="contact" class="relative py-24 lg:py-32 bg-white">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-latte to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <span class="text-terracotta font-semibold text-sm uppercase tracking-widest">Contact Us</span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-espresso leading-tight">
        Visit
        <span class="text-terracotta">Exit Café</span>
      </h2>
      <p class="text-espresso/60 text-lg">
        We'd love to welcome you. Come say hello, or reach out anytime.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-12">
      <!-- Contact Info -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Address -->
        <div class="flex items-start gap-4 group">
          <div class="w-12 h-12 bg-terracotta/10 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-terracotta group-hover:text-cream transition-all duration-300">
            <svg class="w-5 h-5 text-terracotta group-hover:text-cream transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <div>
            <h4 class="font-semibold text-espresso mb-1">Location</h4>
            <p class="text-espresso/60 text-sm leading-relaxed">GR2P+2C2, Basrah,<br/>Basra Governorate, Iraq</p>
          </div>
        </div>

        <!-- Phone -->
        <div class="flex items-start gap-4 group">
          <div class="w-12 h-12 bg-terracotta/10 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-terracotta group-hover:text-cream transition-all duration-300">
            <svg class="w-5 h-5 text-terracotta group-hover:text-cream transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <div>
            <h4 class="font-semibold text-espresso mb-1">Phone</h4>
            <p class="text-espresso/60 text-sm">Contact us via Instagram DM</p>
          </div>
        </div>

        <!-- Hours -->
        <div class="flex items-start gap-4 group">
          <div class="w-12 h-12 bg-terracotta/10 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-terracotta group-hover:text-cream transition-all duration-300">
            <svg class="w-5 h-5 text-terracotta group-hover:text-cream transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <h4 class="font-semibold text-espresso mb-1">Hours</h4>
            <p class="text-espresso/60 text-sm leading-relaxed">
              Open Now<br/>
              Daily: 8:00 AM – 12:00 AM
            </p>
            <div class="flex items-center gap-1.5 mt-1">
              <span class="w-2 h-2 bg-sage rounded-full animate-pulse-soft"></span>
              <span class="text-sage text-xs font-semibold">Currently Open</span>
            </div>
          </div>
        </div>

        <!-- Social -->
        <div class="flex items-start gap-4 group">
          <div class="w-12 h-12 bg-terracotta/10 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-terracotta group-hover:text-cream transition-all duration-300">
            <svg class="w-5 h-5 text-terracotta group-hover:text-cream transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </div>
          <div>
            <h4 class="font-semibold text-espresso mb-1">Social Media</h4>
            <a
              href="https://www.instagram.com/exit_albasra"
              target="_blank"
              rel="noopener noreferrer"
              class="text-terracotta text-sm hover:underline inline-flex items-center gap-1.5"
            >
              @exit_albasra
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Map / Reserve Card -->
      <div class="lg:col-span-3 space-y-6">
        <!-- Map Embed -->
        <div class="relative rounded-3xl overflow-hidden shadow-xl shadow-espresso/10 bg-latte/30 h-80 border border-latte/50">
          <iframe
            title="Exit Café & Restaurant location"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3453.5!2d47.97!3d30.51!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzDCsDMwJzM2LjAiTiA0N8KwNTgnMTIuMCJF!5e0!3m2!1sen!2siq!4v1700000000000!5m2!1sen!2siq"
            width="100%"
            height="100%"
            style="border:0; filter: grayscale(0.2) contrast(1.1);"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <!-- Reservation CTA Card -->
        <div class="bg-gradient-to-br from-espresso to-mocha/80 rounded-3xl p-8 sm:p-10 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 w-40 h-40 bg-terracotta/20 rounded-full blur-3xl"></div>
          <div class="relative z-10 space-y-5">
            <h3 class="font-display text-2xl sm:text-3xl font-bold text-cream">
              Ready for an Unforgettable Experience?
            </h3>
            <p class="text-cream/70 max-w-md mx-auto">
              Walk in or reach out on Instagram to reserve your perfect spot at Exit.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href="https://www.instagram.com/exit_albasra"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-terracotta text-cream px-8 py-4 rounded-full font-semibold hover:bg-caramel transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                Message on Instagram
              </a>
              <a
                href="https://www.google.com/maps/dir/?api=1&destination=Exit+Cafe+Restaurant+Basrah"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm text-cream border border-white/20 px-8 py-4 rounded-full font-semibold hover:bg-white/20 transition-all duration-300"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                Get Directions
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>