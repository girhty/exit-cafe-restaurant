---
const currentYear = new Date().getFullYear();
---

<footer class="bg-espresso text-cream relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-caramel/30 to-transparent"></div>
  
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="space-y-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-cream/10 rounded-lg flex items-center justify-center">
            <span class="text-caramel font-display font-bold text-xl">E</span>
          </div>
          <div>
            <span class="font-display font-bold text-cream text-lg leading-none block">Exit Café</span>
            <span class="text-cream/50 text-xs tracking-widest uppercase">Restaurant</span>
          </div>
        </div>
        <p class="text-cream/50 text-sm leading-relaxed max-w-xs">
          Basrah's most inviting café and restaurant. Where artisan coffees meet authentic Iraqi cuisine in a warm, welcoming atmosphere.
        </p>
        <div class="flex items-center gap-3">
          <a
            href="https://www.instagram.com/exit_albasra"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-cream/10 rounded-full flex items-center justify-center hover:bg-terracotta transition-all duration-300"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a
            href="https://www.google.com/maps/search/Exit+Cafe+Restaurant+Basrah"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-cream/10 rounded-full flex items-center justify-center hover:bg-terracotta transition-all duration-300"
            aria-label="Google Maps"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-display font-bold text-cream text-lg mb-5">Quick Links</h4>
        <ul class="space-y-3">
          <li><a href="#home" class="text-cream/50 hover:text-caramel transition-colors text-sm">Home</a></li>
          <li><a href="#about" class="text-cream/50 hover:text-caramel transition-colors text-sm">About Us</a></li>
          <li><a href="#menu" class="text-cream/50 hover:text-caramel transition-colors text-sm">Our Menu</a></li>
          <li><a href="#gallery" class="text-cream/50 hover:text-caramel transition-colors text-sm">Gallery</a></li>
          <li><a href="#reviews" class="text-cream/50 hover:text-caramel transition-colors text-sm">Reviews</a></li>
          <li><a href="#contact" class="text-cream/50 hover:text-caramel transition-colors text-sm">Contact</a></li>
        </ul>
      </div>

      <!-- Menu Highlights -->
      <div>
        <h4 class="font-display font-bold text-cream text-lg mb-5">Popular Items</h4>
        <ul class="space-y-3">
          <li><span class="text-cream/50 text-sm">Basrah Latte</span></li>
          <li><span class="text-cream/50 text-sm">Rose Cappuccino</span></li>
          <li><span class="text-cream/50 text-sm">Grilled Hammour</span></li>
          <li><span class="text-cream/50 text-sm">Masgouf Platter</span></li>
          <li><span class="text-cream/50 text-sm">Kunafa</span></li>
          <li><span class="text-cream/50 text-sm">Shawarma Plate</span></li>
        </ul>
      </div>

      <!-- Visit Us -->
      <div>
        <h4 class="font-display font-bold text-cream text-lg mb-5">Visit Us</h4>
        <div class="space-y-4">
          <div>
            <p class="text-cream/50 text-sm leading-relaxed">
              GR2P+2C2<br/>
              Basrah, Basra Governorate<br/>
              Iraq
            </p>
          </div>
          <div>
            <p class="text-cream/50 text-sm">Daily: 8:00 AM – 12:00 AM</p>
            <div class="flex items-center gap-1.5 mt-1">
              <span class="w-2 h-2 bg-sage rounded-full animate-pulse-soft"></span>
              <span class="text-sage/80 text-xs font-semibold">Open Now</span>
            </div>
          </div>
          <a
            href="https://www.instagram.com/exit_albasra"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-caramel text-sm font-semibold hover:underline"
          >
            @exit_albasra
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-cream/30 text-sm">
        © {currentYear} Exit Café & Restaurant. All rights reserved.
      </p>
      <p class="text-cream/30 text-sm">
        Crafted with ☕ in Basrah, Iraq
      </p>
    </div>
  </div>
</footer>