---
---

<section id="home" class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-espresso via-espresso/95 to-mocha/90"></div>
  
  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-20 left-10 w-96 h-96 bg-terracotta/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-80 h-80 bg-gold/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-caramel/5 rounded-full blur-3xl"></div>
    
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left Content -->
      <div class="space-y-8">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-5 py-2.5 border border-white/10">
          <span class="w-2 h-2 bg-sage rounded-full animate-pulse-soft"></span>
          <span class="text-cream/80 text-sm font-medium">Open Now in Basrah</span>
        </div>

        <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-cream leading-[1.1] tracking-tight">
          Where Every
          <span class="relative inline-block">
            <span class="relative z-10 text-caramel">Sip</span>
            <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 200 12" fill="none">
              <path d="M2 8C40 2 80 2 100 6C120 10 160 10 198 4" stroke="#C75B39" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </span>
          Tells a
          <em class="text-terracotta font-display italic">Story</em>
        </h1>

        <p class="text-cream/70 text-lg sm:text-xl leading-relaxed max-w-xl">
          Escape the ordinary at Basrah's most inviting café and restaurant. From artisan coffees to authentic Iraqi cuisine — crafted with passion, served with warmth.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#menu"
            class="group inline-flex items-center justify-center gap-3 bg-terracotta text-cream px-8 py-4 rounded-full text-lg font-semibold hover:bg-caramel transition-all duration-300 shadow-xl shadow-terracotta/30 hover:shadow-2xl hover:shadow-caramel/30 hover:scale-105"
          >
            Explore Our Menu
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-3 bg-white/10 backdrop-blur-sm text-cream border border-white/20 px-8 py-4 rounded-full text-lg font-semibold hover:bg-white/20 transition-all duration-300"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Visit Us
          </a>
        </div>

        <!-- Stats -->
        <div class="flex items-center gap-8 pt-4">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
              {[1,2,3,4].map(() => (
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-caramel to-terracotta border-2 border-espresso flex items-center justify-center">
                  <svg class="w-4 h-4 text-cream" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                </div>
              ))}
            </div>
            <div>
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <span class="text-cream font-bold">3.6</span>
              </div>
              <span class="text-cream/50 text-xs">126 Google Reviews</span>
            </div>
          </div>
          <div class="w-px h-10 bg-white/20"></div>
          <div>
            <span class="text-cream font-bold text-lg">@exit_albasra</span>
            <span class="text-cream/50 text-xs block">On Instagram</span>
          </div>
        </div>
      </div>

      <!-- Right: Feature Cards -->
      <div class="relative hidden lg:block">
        <div class="relative space-y-6">
          <!-- Coffee Card -->
          <div class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 border border-white/10 ml-12 animate-fade-up" style="animation-delay: 0.2s;">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-gradient-to-br from-caramel to-gold rounded-2xl flex items-center justify-center shrink-0 shadow-lg">
                <svg class="w-7 h-7 text-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>
              </div>
              <div>
                <h3 class="text-cream font-display font-bold text-xl mb-1">Artisan Coffee</h3>
                <p class="text-cream/60 text-sm leading-relaxed">Expertly roasted & hand-brewed specialty coffees from around the world</p>
              </div>
            </div>
          </div>

          <!-- Food Card -->
          <div class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 border border-white/10 mr-12 animate-fade-up" style="animation-delay: 0.4s;">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-gradient-to-br from-terracotta to-mocha rounded-2xl flex items-center justify-center shrink-0 shadow-lg">
                <svg class="w-7 h-7 text-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0A1.5 1.5 0 003 15.546M12 2v3m0 0a3 3 0 013 3v1a3 3 0 01-6 0v-1a3 3 0 013-3z"/></svg>
              </div>
              <div>
                <h3 class="text-cream font-display font-bold text-xl mb-1">Authentic Cuisine</h3>
                <p class="text-cream/60 text-sm leading-relaxed">Traditional Iraqi flavors meet modern culinary artistry on every plate</p>
              </div>
            </div>
          </div>

          <!-- Ambiance Card -->
          <div class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 border border-white/10 ml-12 animate-fade-up" style="animation-delay: 0.6s;">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-gradient-to-br from-sage to-espresso rounded-2xl flex items-center justify-center shrink-0 shadow-lg">
                <svg class="w-7 h-7 text-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              </div>
              <div>
                <h3 class="text-cream font-display font-bold text-xl mb-1">Cozy Ambiance</h3>
                <p class="text-cream/60 text-sm leading-relaxed">A warm escape designed for connection, comfort & unforgettable moments</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating decoration -->
        <div class="absolute -top-8 -right-8 w-32 h-32 border border-caramel/20 rounded-full animate-float"></div>
        <div class="absolute -bottom-4 -left-4 w-24 h-24 border border-gold/20 rounded-full animate-float" style="animation-delay: 1.5s;"></div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <div class="w-6 h-10 border-2 border-cream/30 rounded-full flex justify-center pt-2">
      <div class="w-1.5 h-3 bg-cream/50 rounded-full"></div>
    </div>
  </div>
</section>