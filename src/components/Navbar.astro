---
const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'About', href: '#about' },
  { label: 'Menu', href: '#menu' },
  { label: 'Gallery', href: '#gallery' },
  { label: 'Reviews', href: '#reviews' },
  { label: 'Contact', href: '#contact' },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  aria-label="Main navigation"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="#home" class="flex items-center gap-3 group" aria-label="Exit Café & Restaurant Home">
        <div class="w-10 h-10 bg-espresso rounded-lg flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform">
          <span class="text-caramel font-display font-bold text-xl">E</span>
        </div>
        <div class="hidden sm:block">
          <span class="font-display font-bold text-espresso text-lg leading-none block transition-colors" id="logo-text">Exit Café</span>
          <span class="text-xs text-mocha tracking-widest uppercase">Restaurant</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-2 text-sm font-medium text-espresso/70 hover:text-espresso rounded-full hover:bg-latte/60 transition-all duration-300"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href="https://www.instagram.com/exit_albasra"
          target="_blank"
          rel="noopener noreferrer"
          class="text-espresso/50 hover:text-terracotta transition-colors"
          aria-label="Follow us on Instagram"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a
          href="#contact"
          class="bg-espresso text-cream px-6 py-2.5 rounded-full text-sm font-semibold hover:bg-terracotta transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105"
        >
          Reserve a Table
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-lg text-espresso hover:bg-latte/60 transition-colors"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-cream/95 backdrop-blur-xl border-t border-latte/50 shadow-2xl">
    <div class="px-4 py-6 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-3 text-espresso/80 hover:text-espresso font-medium rounded-xl hover:bg-latte/50 transition-all"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 px-4">
        <a
          href="#contact"
          class="block text-center bg-espresso text-cream px-6 py-3 rounded-full font-semibold hover:bg-terracotta transition-all"
        >
          Reserve a Table
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  const logoText = document.getElementById('logo-text');
  
  function updateNavbar() {
    if (window.scrollY > 50) {
      navbar?.classList.add('bg-cream/95', 'backdrop-blur-xl', 'shadow-lg', 'shadow-espresso/5');
      logoText?.classList.remove('text-espresso');
    } else {
      navbar?.classList.remove('bg-cream/95', 'backdrop-blur-xl', 'shadow-lg', 'shadow-espresso/5');
      logoText?.classList.add('text-espresso');
    }
  }
  
  window.addEventListener('scroll', updateNavbar);
  updateNavbar();

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    mobileMenuBtn?.setAttribute('aria-expanded', String(isOpen));
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>