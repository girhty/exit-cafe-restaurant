---
const testimonials = [
  {
    name: 'Ahmed K.',
    text: 'The Basrah Latte here is unlike anything I\'ve tasted before. The cardamom and saffron blend is absolutely divine. Exit has become my daily escape!',
    rating: 5,
    date: '2 weeks ago',
  },
  {
    name: 'Fatima R.',
    text: 'Wonderful atmosphere and the food is consistently great. The masgouf platter is authentic and generously portioned. Perfect for family dinners.',
    rating: 4,
    date: '1 month ago',
  },
  {
    name: 'Mohammed S.',
    text: 'Great coffee shop vibes with excellent service. The staff are friendly and the ambiance makes it perfect for working or catching up with friends.',
    rating: 4,
    date: '3 weeks ago',
  },
  {
    name: 'Layla H.',
    text: 'I love coming here for the kunafa — it\'s the best in Basrah! The rose cappuccino is also a must-try. Beautiful interior design too.',
    rating: 5,
    date: '1 week ago',
  },
  {
    name: 'Ali J.',
    text: 'Solid restaurant with good variety. The grilled hammour is fresh and well-seasoned. Prices are reasonable for the quality you get. Recommended!',
    rating: 4,
    date: '2 months ago',
  },
  {
    name: 'Noor T.',
    text: 'Such a cozy spot! The date mocha is my absolute favorite. It\'s my go-to place whenever I need a break from the hustle. Love it here.',
    rating: 5,
    date: '5 days ago',
  },
];
---

<section id="reviews" class="relative py-24 lg:py-32 bg-cream overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-latte to-transparent"></div>
  
  <!-- Background decoration -->
  <div class="absolute top-20 right-0 w-96 h-96 bg-terracotta/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-0 w-80 h-80 bg-caramel/5 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <span class="text-terracotta font-semibold text-sm uppercase tracking-widest">Testimonials</span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-espresso leading-tight">
        What People
        <span class="text-terracotta">Say</span>
      </h2>
      <p class="text-espresso/60 text-lg">
        Don't just take our word for it — hear from our beloved guests.
      </p>
    </div>

    <!-- Rating Summary -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-16 p-8 bg-white rounded-3xl shadow-lg shadow-espresso/5 border border-latte/50 max-w-xl mx-auto">
      <div class="text-center">
        <div class="font-display text-5xl font-bold text-espresso">3.6</div>
        <div class="flex items-center gap-0.5 mt-1">
          {[1,2,3].map(() => (
            <svg class="w-5 h-5 text-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          ))}
          <svg class="w-5 h-5 text-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill-opacity="0.3"/></svg>
        </div>
      </div>
      <div class="w-px h-12 bg-latte hidden sm:block"></div>
      <div class="text-center">
        <div class="font-semibold text-espresso">Based on Google Reviews</div>
        <div class="text-espresso/50 text-sm">126 verified reviews</div>
      </div>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((testimonial) => (
        <div class="bg-white rounded-2xl p-7 border border-latte/50 hover:shadow-xl hover:shadow-espresso/5 transition-all duration-300 hover:-translate-y-1 relative">
          <!-- Quote mark -->
          <div class="absolute top-6 right-6 font-display text-6xl text-latte/40 leading-none select-none">"</div>
          
          <!-- Stars -->
          <div class="flex items-center gap-0.5 mb-4">
            {[1,2,3,4,5].map((star) => (
              <svg class={`w-4 h-4 ${star <= testimonial.rating ? 'text-gold' : 'text-latte'}`} fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>

          <p class="text-espresso/70 leading-relaxed mb-6 relative z-10">{testimonial.text}</p>

          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-gradient-to-br from-caramel to-terracotta rounded-full flex items-center justify-center">
                <span class="text-cream font-semibold text-sm">{testimonial.name.charAt(0)}</span>
              </div>
              <div>
                <span class="font-semibold text-espresso text-sm">{testimonial.name}</span>
                <span class="block text-espresso/40 text-xs">Google Review</span>
              </div>
            </div>
            <span class="text-espresso/30 text-xs">{testimonial.date}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Google Review Link -->
    <div class="text-center mt-12">
      <a
        href="https://www.google.com/maps/search/Exit+Cafe+Restaurant+Basrah"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-white text-espresso px-8 py-4 rounded-full font-semibold border border-latte/50 hover:border-caramel/30 hover:shadow-lg transition-all duration-300 hover:scale-105"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Read All Reviews on Google
      </a>
    </div>
  </div>
</section>